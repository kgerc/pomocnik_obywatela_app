{
  "name": "pisma-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "build:snap": "vite build && react-snap",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "include": [
      "/",
      "/blog",
      "/blog/jak-napisac-reklamacje-telefonu",
      "/blog/odwolanie-od-mandatu-poradnik",
      "/blog/wniosek-zasilek-okresowy-poradnik",
      "/pismo/reklamacja-telefon",
      "/pismo/reklamacja-internet",
      "/pismo/reklamacja-kurier",
      "/pismo/odwolanie-od-mandatu",
      "/pismo/wniosek-zasilek-okresowy",
      "/pismo/wniosek-zasilek-staly",
      "/pismo/wypowiedzenie-umowy-najmu",
      "/pismo/reklamacja-produktu-wadliwego",
      "/pismo/odwolanie-od-decyzji-ubezpieczyciela",
      "/pismo/wniosek-pozwolenie-na-budowe",
      "/pismo/wniosek-dodatek-mieszkaniowy",
      "/pismo/wniosek-urlop-dziekanski",
      "/pismo/wniosek-zawieszenie-dzialalnosci",
      "/pismo/odwolanie-do-uke",
      "/pismo/reklamacja-poczta-polska",
      "/pismo/wniosek-swiadectwo-pracy",
      "/pismo/reklamacja-telewizji",
      "/pismo/wniosek-pomoc-ofiara-przemocy",
      "/pismo/wniosek-stypendium-socjalne",
      "/pismo/wniosek-o-rente"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.263.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.10.1",
    "react-snap": "^1.23.0",
    "vite": "^4.4.5"
  }
}
